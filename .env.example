# Hugging Face token: https://huggingface.co/settings/tokens
LLM_API_KEY=hf_your_token_here

# Hugging Face Inference Providers OpenAI-compatible endpoint
LLM_BASE_URL=https://router.huggingface.co/v1

# Code model with tool/function calling support
LLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Optional generation settings
LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2000

# Agent settings
AGENT_INDEX_PATH=code_index.json
AGENT_LOG_PATH=logs/agent_steps.jsonl
AGENT_MAX_STEPS=8
